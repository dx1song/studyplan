# 复制本文件为 .env 并填入真实值

# ---- LLM 配置（OpenAI 兼容接口）----
# DeepSeek 示例：base_url=https://api.deepseek.com  model=deepseek-chat
# 通义千问（DashScope 兼容模式）示例：base_url=https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 调用参数 ----
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=8192

# ---- 无密钥联调：设为 true 时跳过真实 LLM，返回内置示例数据 ----
USE_MOCK=false

# ---- Excel 输出目录（默认 backend/output）----
OUTPUT_DIR=./output
